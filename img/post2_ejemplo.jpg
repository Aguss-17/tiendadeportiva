    position: relative;
    overflow: hidden;
    transform-origin: center;
  }
  .visit-button-animate.pulse-glow {
    animation: pulseGlowShadow 1000ms ease-in-out 0ms 1;
  }
  .visit-button-animate.pulse-glow :where(svg, span, div) {
    transform-origin: center;
    animation: pulseGlowScale 1000ms ease-in-out 0ms 1;
  }
  @keyframes pulseGlowShadow {
    0%, 100% {
      box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.4);
    }
    50% {
      box-shadow: 0 0 20px 5px rgba(255, 255, 255, 0.2);
    }
  }
  @keyframes pulseGlowScale {
    0%, 100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.05);
    }
  }
  .visit-button-animate::before {
    content: '';
    position: absolute;
    top: 0;
    left: -120%;
    width: 120%;
    height: 100%;
    background: linear-gradient(90deg,
      transparent 0%,
      rgba(255,255,255,0.2) 30%,
      rgba(255,255,255,0.7) 50%,
      rgba(255,255,255,0.2) 70%,
      transparent 100%);
    animation: visitBtnShimmer 1000ms ease-out 0ms 1;
  }
  @keyframes visitBtnShimmer {
    0% { left: -120%; }
    100% { left: 100%; }
  }</style><a class="d3L NLN sY1 S9z CCY Qga RCK BG7 a_A M7K F10" href="https://www.instagram.com/hi.mmstudio/" rel="nofollow" tabindex="0"><div class="CWH tg7 fxm wm0">Visitar sitio</div></a></div></div></div></div></div><div data-testid="closeup-metadata-details-flex" class="jzS ujU un8 C9i TB_"><div class="qGb u8x zI7" style="width: 100%;"><div data-test-id="closeup-metadata-details-divider" class="zI7" style="opacity: 1; width: 100%; border-top: 1px solid rgb(233, 233, 233);"></div></div><div class="zI7" style="padding-right: 0px; overflow-x: hidden; width: 100%;"><div class="a3i u8x zI7"><div id="canonical-card" class="zI7" style="overflow-x: hidden;"><div class="jzS un8 C9i TB_" data-test-id="canonical-card"><div class="xuA"><div aria-disabled="true" aria-expanded="false" aria-label="Tap area to expand/collapse the comments section if there are any comments." class="S9z eEj Tbt L4E" data-test-id="canonical-card-tap-area" role="button"><div class="xuA"><div class="GuY zI7"><div aria-disabled="true" class="S9z eEj Tbt L4E" role="button"><div class="zI7"><div class="KS5 b8T hs0 ujU un8 C9i TB_" data-test-id="collapsible-header"><h2 class="wdg dyH CWH sw7 hc9 e85" id="comments-heading">Todavía no hay comentarios</h2><div class="Jea KS5 hs0 zI7"><div class="BfI zI7" style="transform: rotate(0deg); transition: 600ms cubic-bezier(0.25, 1, 0.5, 1);"><button aria-label="Ícono de expandir" class="yfm" data-test-id="collapse-button" disabled="" type="button"><div class="KuF S9z v07"><div class="SPw hrh uPZ Owy" style="height: 28px; width: 28px;"><svg aria-hidden="true" aria-label="" class="gUZ U9O m9E" height="16" role="img" viewBox="0 0 24 24" width="16"><path d="M23.7 8.7 12 20.42.3 8.71l1.4-1.42L12 17.6 22.3 7.3z"></path></svg></div></div></button></div></div></div></div></div><div data-test-id="comment-heading-divider" class="zI7" style="opacity: 0; width: 100%;"></div></div></div></div></div><div class="xuA"><div class="zI7" style="padding-right: 8px; padding-left: 