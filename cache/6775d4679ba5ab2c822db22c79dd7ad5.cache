a:1:{i:0;a:11:{s:2:"id";i:29;s:6:"nombre";s:44:"Straps Deportivos - Correas de levantamiento";s:11:"descripcion";s:271:"Material: Mayor firmeza y seguridad en tus levantamientos. Fabricados en algodón reforzado con costuras resistentes, brindan un agarre firme para ejercicios de fuerza como peso muerto, dominadas o remo. Diseño ergonómico, fácil de ajustar y cómodo al uso prolongado.";s:6:"precio";s:9:"2872.0000";s:6:"imagen";s:29:"68a2d7aeda0ae-6accesorios.jpg";s:14:"fecha_creacion";s:19:"2025-08-17 19:35:10";s:9:"en_oferta";i:0;s:6:"talles";s:7:"Ninguno";s:7:"colores";s:15:"Azul,Verde,Rosa";s:3:"vip";i:0;s:12:"id_categoria";i:4;}}